datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User role enum (Specification Section 4)
enum UserRole {
  STU // Student
  FAC // Faculty
  COR // Transport Coordinator
  TEC // Fleet Technician
  SAD // Super Admin
  MGT // College Management
  SEC // Security Staff (Read-Only)
}

// Device lifecycle states (Specification 11.5 & Conflict C-01)
enum DeviceStatus {
  PROVISIONED
  ACTIVE
  REVOKED
  RETIRED
}

// Bus operational states
enum BusStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(255)
  name         String        @db.VarChar(128)
  phone        String?       @db.VarChar(32)
  role         UserRole      @default(STU)
  is_active    Boolean       @default(true)
  created_at   DateTime      @default(now()) @db.Timestamptz
  updated_at   DateTime      @updatedAt @db.Timestamptz
  is_synthetic Boolean       @default(false)

  sessions     Session[]
  mfa_factors  MfaFactor[]
  recovery_codes RecoveryCode[]

  @@map("users")
}

model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String    @unique @db.VarChar(255)
  user_agent         String?   @db.VarChar(512)
  ip_address         String?   @db.VarChar(64)
  expires_at         DateTime  @db.Timestamptz
  last_activity_at   DateTime  @default(now()) @db.Timestamptz
  revoked_at         DateTime? @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @updatedAt @db.Timestamptz
  is_synthetic       Boolean   @default(false)

  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sessions")
}

model MfaFactor {
  id               String    @id @default(uuid()) @db.Uuid
  user_id          String    @db.Uuid
  factor_type      String    @default("TOTP") @db.VarChar(32)
  secret_encrypted String    @db.Text
  is_verified      Boolean   @default(false)
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz
  is_synthetic     Boolean   @default(false)

  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("mfa_factors")
}

model RecoveryCode {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  code_hash    String    @db.VarChar(255)
  consumed_at  DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz
  is_synthetic Boolean   @default(false)

  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("recovery_codes")
}

model EmailOtp {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @db.VarChar(255)
  otp_hash     String    @db.VarChar(255)
  attempts     Int       @default(0)
  locked_until DateTime? @db.Timestamptz
  consumed_at  DateTime? @db.Timestamptz
  expires_at   DateTime  @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz
  is_synthetic Boolean   @default(false)

  @@index([email])
  @@map("email_otps")
}

model Setting {
  id           String    @id @default(uuid()) @db.Uuid
  key          String    @unique @db.VarChar(128)
  value        Json
  description  String?   @db.Text
  updated_by   String?   @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)

  @@map("settings")
}

// Append-only audit log (Rule R-09: No UPDATE or DELETE allowed)
model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  actor_id     String?   @db.Uuid
  actor_role   String?   @db.VarChar(32)
  action       String    @db.VarChar(64)
  entity       String    @db.VarChar(64)
  entity_id    String?   @db.VarChar(128)
  old_values   Json?
  new_values   Json?
  ip_address   String?   @db.VarChar(64)
  request_id   String?   @db.VarChar(64)
  created_at   DateTime  @default(now()) @db.Timestamptz
  is_synthetic Boolean   @default(false)

  @@index([actor_id])
  @@index([entity, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

model Device {
  id               String       @id @db.VarChar(32) // HW_xxxx
  serial_number    String       @unique @db.VarChar(64)
  imei             String       @unique @db.VarChar(15)
  iccid            String       @db.VarChar(20)
  model            String       @default("ESP8266_NEO6M") @db.VarChar(64)
  nickname         String?      @db.VarChar(64)
  firmware_version String       @default("1.2.0") @db.VarChar(32)
  status           DeviceStatus @default(PROVISIONED)
  first_used_at    DateTime?    @db.Timestamptz
  created_at       DateTime     @default(now()) @db.Timestamptz
  updated_at       DateTime     @updatedAt @db.Timestamptz
  is_synthetic     Boolean      @default(false)

  tokens           DeviceToken[]
  bus_links        DeviceBusLink[]
  telemetry        LocationTelemetry[]

  @@map("devices")
}

model DeviceToken {
  id           String    @id @default(uuid()) @db.Uuid
  device_id    String    @db.VarChar(32)
  token_hash   String    @unique @db.VarChar(255)
  key_version  Int       @default(1)
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now()) @db.Timestamptz
  is_synthetic Boolean   @default(false)

  device       Device    @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id])
  @@map("device_tokens")
}

model Route {
  id              String      @id @default(uuid()) @db.Uuid
  code            String      @unique @db.VarChar(32)
  name            String      @db.VarChar(128)
  origin          String      @db.VarChar(128)
  destination     String      @db.VarChar(128)
  polyline        Json?
  geometry_source String      @default("SAVED_GEOMETRY") @db.VarChar(32)
  distance_meters Int?
  is_active       Boolean     @default(true)
  created_at      DateTime    @default(now()) @db.Timestamptz
  updated_at      DateTime    @updatedAt @db.Timestamptz
  is_synthetic    Boolean     @default(false)

  stops           RouteStop[]
  buses           Bus[]

  @@map("routes")
}

model RouteStop {
  id             String    @id @default(uuid()) @db.Uuid
  route_id       String    @db.Uuid
  name           String    @db.VarChar(128)
  sequence       Int
  latitude       Decimal   @db.Decimal(10, 7)
  longitude      Decimal   @db.Decimal(10, 7)
  scheduled_time String?   @db.VarChar(16)
  status         String    @default("SCHEDULED") @db.VarChar(32)
  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @updatedAt @db.Timestamptz
  is_synthetic   Boolean   @default(false)

  route          Route     @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@index([route_id])
  @@index([route_id, sequence])
  @@map("route_stops")
}

model Bus {
  id                String          @id @default(uuid()) @db.Uuid
  bus_number        String          @unique @db.VarChar(32)
  registration      String          @unique @db.VarChar(32)
  display_name      String?         @db.VarChar(64)
  assigned_route_id String?         @db.Uuid
  capacity          Int             @default(50)
  status            BusStatus       @default(ACTIVE)
  insurance_expiry  DateTime?       @db.Date
  fitness_expiry    DateTime?       @db.Date
  pollution_expiry  DateTime?       @db.Date
  permit_expiry     DateTime?       @db.Date
  created_at        DateTime        @default(now()) @db.Timestamptz
  updated_at        DateTime        @updatedAt @db.Timestamptz
  is_synthetic      Boolean         @default(false)

  assigned_route    Route?          @relation(fields: [assigned_route_id], references: [id], onDelete: SetNull)
  device_links      DeviceBusLink[]
  telemetry         LocationTelemetry[]

  @@index([assigned_route_id])
  @@map("buses")
}

model DeviceBusLink {
  id           String    @id @default(uuid()) @db.Uuid
  device_id    String    @db.VarChar(32)
  bus_id       String    @db.Uuid
  valid_from   DateTime  @default(now()) @db.Timestamptz
  valid_to     DateTime? @db.Timestamptz
  created_by   String?   @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  is_synthetic Boolean   @default(false)

  device       Device    @relation(fields: [device_id], references: [id], onDelete: Cascade)
  bus          Bus       @relation(fields: [bus_id], references: [id], onDelete: Cascade)

  @@index([device_id])
  @@index([bus_id])
  @@map("device_bus_links")
}

model LocationTelemetry {
  id               String    @id @default(uuid()) @db.Uuid
  bus_id           String    @db.Uuid
  device_id        String    @db.VarChar(32)
  latitude         Decimal   @db.Decimal(10, 7)
  longitude        Decimal   @db.Decimal(10, 7)
  speed_kmh        Decimal   @db.Decimal(5, 2)
  heading_deg      Decimal   @db.Decimal(5, 2)
  recorded_at      DateTime  @db.Timestamptz
  received_at      DateTime  @default(now()) @db.Timestamptz
  telemetry_source String    @default("HARDWARE") @db.VarChar(32)
  is_simulated     Boolean   @default(false)
  is_synthetic     Boolean   @default(false)

  bus              Bus       @relation(fields: [bus_id], references: [id], onDelete: Cascade)
  device           Device    @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([bus_id, recorded_at])
  @@index([device_id, recorded_at])
  @@map("location_telemetry")
}

model MaintenanceTicket {
  id               String    @id @default(uuid()) @db.Uuid
  entity_type      String    @db.VarChar(32)
  entity_id        String    @db.VarChar(128)
  category         String    @db.VarChar(64)
  severity         String    @db.VarChar(32)
  status           String    @default("OPEN") @db.VarChar(32)
  title            String    @db.VarChar(255)
  description      String    @db.Text
  reported_by      String    @db.VarChar(128)
  assigned_to      String?   @db.VarChar(128)
  resolution_notes String?   @db.Text
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz
  is_synthetic     Boolean   @default(false)

  @@index([entity_type, entity_id])
  @@index([status])
  @@map("maintenance_tickets")
}

model ServiceAlert {
  id           String    @id @default(uuid()) @db.Uuid
  category     String    @db.VarChar(32)
  priority     String    @db.VarChar(32)
  title        String    @db.VarChar(255)
  message      String    @db.Text
  read         Boolean   @default(false)
  created_at   DateTime  @default(now()) @db.Timestamptz
  is_synthetic Boolean   @default(false)

  @@index([priority])
  @@index([created_at])
  @@map("service_alerts")
}

model FeatureFlag {
  id           String    @id @default(uuid()) @db.Uuid
  flag_key     String    @unique @db.VarChar(64)
  is_enabled   Boolean   @default(false)
  description  String?   @db.Text
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)

  @@map("feature_flags")
}

model RateCounter {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @unique @db.VarChar(128)
  counter           Int      @default(1)
  window_expires_at DateTime @db.Timestamptz
  created_at        DateTime @default(now()) @db.Timestamptz

  @@map("rate_counters")
}
