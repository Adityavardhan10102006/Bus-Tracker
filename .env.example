# ==============================================================================
# VJIT Bus Tracker - Local Node.js Development Environment (Direct Workflow)
# Docker is NOT required. Connects to local PostgreSQL 16 with PostGIS.
# ==============================================================================

# Application Environment (local, staging, production)
APP_ENV=local
NODE_ENV=development
PORT=3000

# Database URLs (PostgreSQL 16 with PostGIS)
# app_runtime role for API operations
DATABASE_URL=postgresql://app_runtime:runtime_secure_pass_phrase_vjit_2026@localhost:5432/bus_tracker_dev?schema=public
# app_migrator role for running schema migrations
DATABASE_URL_MIGRATIONS=postgresql://app_migrator:migrator_secure_pass_phrase_vjit_2026@localhost:5432/bus_tracker_dev?schema=public
# app_worker role for background processors
DATABASE_URL_WORKER=postgresql://app_worker:worker_secure_pass_phrase_vjit_2026@localhost:5432/bus_tracker_dev?schema=public

# Public Hosts
API_PUBLIC_HOST=localhost:3000
INGEST_PUBLIC_HOST=localhost:3000
ADMIN_PUBLIC_HOST=localhost:5173

# Authentication & Cryptographic Keys (Min 32 characters, no common words)
JWT_SECRET=vjit_jwt_signing_key_production_grade_entropy_2026_x89a
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Key rotation maps (JSON mapping of key versions to HMAC secrets)
DEVICE_TOKEN_HMAC_KEYS={"v1":"vjit_device_token_hmac_entropy_keyval_cluster_987"}
QR_HMAC_KEYS={"v1":"vjit_qr_signature_hmac_entropy_keyval_cluster_456"}

# Region & External Service Bindings
AWS_REGION=ap-south-1
SIMULATOR_ALLOWED_HOSTS=localhost,127.0.0.1
